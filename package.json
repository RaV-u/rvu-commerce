{
  "name": "rvu-commerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "vite build --config apps/web/vite.config.ts && npm run build:server",
    "typecheck": "tsc --noEmit",
    "start": "node --import tsx apps/api/src/main.ts",
    "migrate": "node --import tsx apps/api/src/migrate.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:ui": "node --import tsx --test tests/ui.test.tsx",
    "build:server": "./node_modules/.bin/esbuild apps/api/src/main.ts apps/api/src/migrate.ts scripts/reset-local.mjs --bundle --minify --platform=node --format=esm --packages=external --define:process.env.RVU_CONTROL_SERVICE='\"disabled\"' --outdir=dist/server --log-level=warning"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "lucide-react": "1.54.0",
    "nodemailer": "10.0.16",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "smtp-server": "3.19.18",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "yaml": "2.9.1"
  }
}
